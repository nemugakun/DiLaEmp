@using DiLaEmp.Localization
@using DiLaEmpLibrary.Utils
@inject IStringLocalizer<CultureDiLaEmp> Loc


<div class="d-flex flex-wrap gap-3 ms-5">
@foreach (var dayOfWeek in weeks)
{
    <div class="d-flex align-items-baseline gap-3 border p-2 
  @( @* Add a yellow (warning) background color to the input if the hours on that day are 0. *@
    dayOfWeek == DayOfWeek.Monday && HoursOnMonday == TimeSpan.Zero ? bootstrapColorIfHoursOnADayAreZero :
    dayOfWeek == DayOfWeek.Tuesday && HoursOnTuesday == TimeSpan.Zero ? bootstrapColorIfHoursOnADayAreZero :
    dayOfWeek == DayOfWeek.Wednesday && HoursOnWednesday == TimeSpan.Zero ? bootstrapColorIfHoursOnADayAreZero :
    dayOfWeek == DayOfWeek.Thursday && HoursOnThursday == TimeSpan.Zero ? bootstrapColorIfHoursOnADayAreZero :
    dayOfWeek == DayOfWeek.Friday && HoursOnFriday == TimeSpan.Zero ? bootstrapColorIfHoursOnADayAreZero :
    dayOfWeek == DayOfWeek.Saturday && HoursOnSaturday == TimeSpan.Zero ? bootstrapColorIfHoursOnADayAreZero :
    dayOfWeek == DayOfWeek.Sunday && HoursOnSunday == TimeSpan.Zero ? bootstrapColorIfHoursOnADayAreZero : ""
    )
">
        <div class="form-label text-nowrap">@DayOfWeekUtils.GetNameOfDayOfWeek(dayOfWeek, CultureInfo.CurrentCulture): </div>
            @if (dayOfWeek == DayOfWeek.Monday)
            {
                <DayOfWeekTimeSpan DayOfWeek="@HoursOnMonday" DayOfWeekChanged="OnMondayChange"/>
            } 
            else if (dayOfWeek == DayOfWeek.Tuesday)
            {
                <DayOfWeekTimeSpan DayOfWeek="@HoursOnTuesday" DayOfWeekChanged="OnTuesdayChange"/>
            } 
            else if (dayOfWeek == DayOfWeek.Wednesday)
            {
                <DayOfWeekTimeSpan DayOfWeek="@HoursOnWednesday" DayOfWeekChanged="OnWednesdayChange"/>
            }
            else if (dayOfWeek == DayOfWeek.Thursday)
            {
                <DayOfWeekTimeSpan DayOfWeek="@HoursOnThursday" DayOfWeekChanged="OnThursdayChange"/>
            }
            else if (dayOfWeek == DayOfWeek.Friday)
            {
                <DayOfWeekTimeSpan DayOfWeek="@HoursOnFriday" DayOfWeekChanged="OnFridayChange"/>
            }
            else if (dayOfWeek == DayOfWeek.Saturday)
            {
                <DayOfWeekTimeSpan DayOfWeek="@HoursOnSaturday" DayOfWeekChanged="OnSaturdayChange"/>
            }
            else //dayOfWeek is Sunday
            {
                <DayOfWeekTimeSpan DayOfWeek="@HoursOnSunday" DayOfWeekChanged="OnSundayChange"/>
            }
           
        <div class="form-label"> @Loc["hours"] </div>
    </div>
}
</div>


@code{
    [Parameter]
    public TimeSpan HoursOnMonday { get; set; }
    [Parameter]
    public EventCallback<TimeSpan> HoursOnMondayChanged { get; set; }
    private async Task OnMondayChange(TimeSpan args)
    {
        await HoursOnMondayChanged.InvokeAsync(args);
    }

    [Parameter]
    public TimeSpan HoursOnTuesday { get; set; }
    [Parameter]
    public EventCallback<TimeSpan> HoursOnTuesdayChanged { get; set; }
    private async Task OnTuesdayChange(TimeSpan args)
    {
        await HoursOnTuesdayChanged.InvokeAsync(args);
    }

    [Parameter]
    public TimeSpan HoursOnWednesday { get; set; }
    [Parameter]
    public EventCallback<TimeSpan> HoursOnWednesdayChanged { get; set; }
    private async Task OnWednesdayChange(TimeSpan args)
    {
        await HoursOnWednesdayChanged.InvokeAsync(args);
    }

    [Parameter]
    public TimeSpan HoursOnThursday { get; set; }
    [Parameter]
    public EventCallback<TimeSpan> HoursOnThursdayChanged { get; set; }
    private async Task OnThursdayChange(TimeSpan args)
    {
        await HoursOnThursdayChanged.InvokeAsync(args);
    }

    [Parameter]
    public TimeSpan HoursOnFriday { get; set; }
    [Parameter]
    public EventCallback<TimeSpan> HoursOnFridayChanged { get; set; }
    private async Task OnFridayChange(TimeSpan args)
    {
        await HoursOnFridayChanged.InvokeAsync(args);
    }

    [Parameter]
    public TimeSpan HoursOnSaturday { get; set; }
    [Parameter]
    public EventCallback<TimeSpan> HoursOnSaturdayChanged { get; set; }
    private async Task OnSaturdayChange(TimeSpan args)
    {
        await HoursOnSaturdayChanged.InvokeAsync(args);
    }

    [Parameter]
    public TimeSpan HoursOnSunday { get; set; }
    [Parameter]
    public EventCallback<TimeSpan> HoursOnSundayChanged { get; set; }
    private async Task OnSundayChange(TimeSpan args)
    {
        await HoursOnSundayChanged.InvokeAsync(args);
    }

    private List<DayOfWeek> weeks = DayOfWeekUtils.GetWeekFromCulture(CultureInfo.CurrentCulture);
    private string bootstrapColorIfHoursOnADayAreZero = "bg-warning-subtle";
}